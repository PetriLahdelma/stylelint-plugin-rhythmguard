{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "layout": {
    "$type": "dimension",
    "gap": {
      "xs": { "$value": { "value": 4, "unit": "px" } },
      "sm": { "$value": { "value": 8, "unit": "px" } },
      "md": { "$value": { "value": 12, "unit": "px" } }
    },
    "inset": {
      "sm": { "$value": "{layout.gap.sm}" },
      "md": { "$value": { "value": 16, "unit": "px" } },
      "lg": { "$value": { "value": 24, "unit": "px" } }
    },
    "stack": {
      "xl": { "$value": { "value": 2, "unit": "rem" } }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 2, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "body": { "$value": { "value": 15, "unit": "px" } }
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "thin": { "$value": { "value": 1, "unit": "px" } }
    }
  },
  "color": {
    "$type": "color",
    "brand": { "$value": { "colorSpace": "srgb", "components": [0, 0, 1] } }
  }
}
