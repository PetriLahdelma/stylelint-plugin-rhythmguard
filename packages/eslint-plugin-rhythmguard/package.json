{
  "name": "eslint-plugin-rhythmguard",
  "version": "3.20.1",
  "description": "Nobody chose 13px; Rhythmguard reads the spacing scale from your design tokens, reports off-scale spacing in CSS, SCSS and Tailwind class strings with the two nearest steps, and fails CI only on new drift. This package holds the Tailwind v4 class-string rules for ESLint and Oxlint; the Stylelint rules and the audit, which read DTCG, Style Dictionary, Tailwind @theme and Sass tokens, are in stylelint-plugin-rhythmguard.",
  "license": "MIT",
  "author": "Petri Lahdelma",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "import": "./index.mjs"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "tailwindcss",
    "tailwind",
    "design-system",
    "design-tokens",
    "spacing-scale",
    "spacing",
    "linting",
    "tailwind-v4",
    "oxlint",
    "oxlint-plugin",
    "spacing-lint",
    "design-token-lint",
    "dtcg",
    "style-dictionary"
  ],
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "dependencies": {
    "stylelint-plugin-rhythmguard": "^3.20.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PetriLahdelma/stylelint-plugin-rhythmguard.git",
    "directory": "packages/eslint-plugin-rhythmguard"
  },
  "homepage": "https://github.com/petrilahdelma/stylelint-plugin-rhythmguard/tree/main/packages/eslint-plugin-rhythmguard#readme",
  "bugs": {
    "url": "https://github.com/petrilahdelma/stylelint-plugin-rhythmguard/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
