{
  "name": "rhythmguard",
  "version": "3.20.1",
  "description": "Nobody chose 13px; Rhythmguard reads the spacing scale from your design tokens, reports off-scale spacing in CSS, SCSS and Tailwind class strings with the two nearest steps, and fails CI only on new drift. The rhythmguard command: a zero-config audit that reads DTCG, Style Dictionary, Tailwind v4 @theme and Sass tokens; the class-string rules for ESLint and Oxlint are in eslint-plugin-rhythmguard.",
  "license": "MIT",
  "author": "Petri Lahdelma",
  "bin": {
    "rhythmguard": "bin.js"
  },
  "files": [
    "bin.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "stylelint",
    "css",
    "scss",
    "tailwindcss",
    "design-system",
    "design-tokens",
    "spacing-scale",
    "spacing",
    "audit",
    "cli",
    "dtcg",
    "w3c-design-tokens",
    "style-dictionary",
    "tokens-studio",
    "tailwind-v4",
    "sass",
    "oxlint",
    "design-token-lint",
    "spacing-lint",
    "css-linter",
    "8pt-grid"
  ],
  "dependencies": {
    "postcss-scss": "^4.0.0",
    "stylelint": "^16.7.0 || ^17.0.0 || ^18.0.0",
    "stylelint-plugin-rhythmguard": "^3.20.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PetriLahdelma/stylelint-plugin-rhythmguard.git",
    "directory": "packages/rhythmguard"
  },
  "homepage": "https://github.com/petrilahdelma/stylelint-plugin-rhythmguard#readme",
  "bugs": {
    "url": "https://github.com/petrilahdelma/stylelint-plugin-rhythmguard/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
